---

import { Image } from "astro:assets";
import logoImage from "../img/logo.png"
import icCeet from "../img/ic_ceet.png"
import icSanTeleco from "../img/ic_santeleco.png"
import icEet from "../img/ic_eet.png"
import "../styles/style.css"

interface Props {
	title?: string
}

const { title } = Astro.props;

---

<script>
  const year = document.getElementById("year");
    
  if (year) {
    year.innerText = new Date().getFullYear().toString();
  }
</script>

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{title ?? "DAAT"}</title>
        <link rel="icon" href="/img/favicon.png">
        <script is:inline defer src="/jquery.min.js"></script>
        <script is:inline defer src="/bootstrap.min.js"></script>
    </head>
    <body>
        <div id="app">
            <nav class="navbar navbar-expand-lg navbar-light bg-light">
                <div class="container-fluid"> 
                    <a class="navbar-brand" href="/">
                        <img class="icon-logo" src={logoImage.src} alt="Inicio">
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
                          <span class="navbar-toggler-icon"></span>
                        </button>
                    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
                        <div class="navbar-nav">
                            <a class="nav-item nav-link" href="/sobre-nosotros">Quiénes somos</a>
                            <a class="nav-item nav-link" href="/taquillas">Alquiler de taquillas</a>
                        </div>
                    </div>
                </div>
            </nav>

           <slot/>
        </div>

        <footer class="footer">
            <div id="footer-links">
                <a class="navbar-brand" href="https://ceet.org.es/blog/" target="_blank">
                    <Image class="icon-logo" src={icCeet} alt="Blog CEET">
                    <span>CEET</span>
                </a>
                <a class="navbar-brand" href="https://santeleco.uvigo.es/" target="_blank">
                    <Image class="icon-logo" src={icSanTeleco} alt="San Teleco">
                    <span>San Teleco</span>
                </a>
                <a class="navbar-brand" href="http://teleco.uvigo.es/index.php/es/" target="_blank">
                    <Image class="icon-logo" src={icEet} alt="Escola de Enxeñaría de Telecomunicación">
                    <span>EET</span>
                </a>
            </div>
            <div id="copyright">
                &copy; <span id="year"></span> DAAT | Todos los derechos reservados. Esta web y su contenido ha sido creado por daat.uvigo.es
            </div>
        </footer>
    </body>
</html>